{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "7808ffb275354e72a28c083237e6e128",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "BalatroSwirl (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -836.0,
            "y": 95.0,
            "width": 222.0,
            "height": 286.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a566d9ff41d64543b07029e3595956d0"
        },
        {
            "m_Id": "f53a1a66ca8f4d4fa2c954edd2ae968e"
        },
        {
            "m_Id": "a37e9e0d1da94f8ca76cfd7588896909"
        },
        {
            "m_Id": "e2723d4662c948869c4987abb695edbf"
        },
        {
            "m_Id": "ddea8e26239f4958b1ac71c8d043e29d"
        },
        {
            "m_Id": "8fb8480e699644d4a1fc8c4311d5e9db"
        },
        {
            "m_Id": "e3d4f95918c043809780a038bebe9f1c"
        },
        {
            "m_Id": "2ca5e3adb9364361a28974aa3d392842"
        },
        {
            "m_Id": "b4d4c7595e0b4bf880d49444d6a1a36e"
        },
        {
            "m_Id": "57047b9555804319a945db133d7f6d04"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BalatroSwirl",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 rayDir = normalize(ViewDir);\r\nfloat safePixel = max(PixelSize, 1.0);\r\n\r\nfloat2 xz = floor(rayDir.xz * safePixel) / safePixel;\r\nfloat2 swirlUV = xz * 2.4;\r\n\r\nfloat swirlSpeed = TimeVal * SpinSpeed * 0.25;\r\nfloat radius = length(swirlUV);\r\nfloat twist = swirlSpeed - 0.35 * radius * SwirlAmount;\r\n\r\nfloat twistCos = cos(twist);\r\nfloat twistSin = sin(twist);\r\nswirlUV = float2(\r\n    swirlUV.x * twistCos - swirlUV.y * twistSin,\r\n    swirlUV.x * twistSin + swirlUV.y * twistCos\r\n);\r\nswirlUV *= 28.0;\r\n\r\nfloat2 warpUV = swirlUV;\r\n\r\n[unroll]\r\nfor (int i = 0; i < 5; i++)\r\n{\r\n    warpUV += sin(max(swirlUV.x, swirlUV.y)) + swirlUV;\r\n    swirlUV += 0.5 * float2(\r\n        cos(5.1123314 + 0.353 * warpUV.y + swirlSpeed * 0.131121),\r\n        sin(warpUV.x - 0.113 * swirlSpeed)\r\n    );\r\n    swirlUV -= 1.0 * cos(swirlUV.x + swirlUV.y) - 1.0 * sin(swirlUV.x * 0.711 - swirlUV.y);\r\n}\r\n\r\nfloat contrastMod = (0.25 * Contrast + 0.5 * SwirlAmount + 1.2);\r\nfloat paintRes = frac(length(swirlUV) * 0.035 * contrastMod) * 1.8;\r\n\r\nfloat c1p = max(0.0, 1.0 - contrastMod * abs(1.0 - paintRes));\r\nfloat c2p = max(0.0, 1.0 - contrastMod * abs(paintRes));\r\nfloat c3p = 1.0 - min(1.0, c1p + c2p);\r\n\r\nfloat highlight = 0.2 * max(c1p * 5.0 - 4.0, 0.0) + 0.4 * max(c2p * 5.0 - 4.0, 0.0);\r\nfloat safeContrast = max(Contrast, 0.01);\r\n\r\nOutColor = (0.1 / safeContrast) * Color1\r\n         + (1.0 - 0.3 / safeContrast) * (\r\n               Color1 * c1p +\r\n               Color2 * c2p +\r\n               float4(c3p * Color3.rgb, c3p * Color1.a)\r\n           )\r\n         + highlight;"
}

